// Per-map baseline weights for the "Balanced" preset (scaled proportionally by your preset when enableLocationsConfig is true).
// Whole integers only; pools exceeding int.MaxValue / 2 are normalized automatically.
{
    "jacketContainer": {
        // SPT 4.1.6 Jacket pool: 10789 (107 items) -> ~25.0 keys / 100 on Balanced
        "key": { "notExist": 25, "common": 25, "rare": 12, "superRare": 5 },
        "keycard": { "notExist": 8, "common": 8, "rare": 4, "superRare": 2 }
    },
    "duffleBagContainer": {
        // No Duffle Bags on Labyrinth
        "key": { "notExist": 0, "common": 0, "rare": 0, "superRare": 0 },
        "keycard": { "notExist": 0, "common": 0, "rare": 0, "superRare": 0 }
    },
    "deadScavContainer": {
        // SPT 4.1.6 Dead Scav pool: 166432 (610 items) -> ~7.0 keys / 100 on Balanced
        "key": { "notExist": 40, "common": 40, "rare": 20, "superRare": 8 },
        "keycard": { "notExist": 12, "common": 12, "rare": 6, "superRare": 4 }
    }
}
