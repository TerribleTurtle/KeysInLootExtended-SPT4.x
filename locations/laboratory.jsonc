/*
  LOCATION CONFIGURATION (Advanced Map-Specific Spawn Overrides)
  - 'notExist', 'common', 'rare', 'superRare' map to the item's internal RarityPvE tag.
  - The numbers act as the 'relativeProbability' spawn weight.
  - WARNING: Do not use decimals. Do not use absurdly large numbers. The maximum safe sum of all items in a pool is 2,147,483,647 (32-bit integer limit). If exceeded, loot generation breaks.
  - This file is ONLY loaded if 'enableLocationsConfig' is set to true in the global config.jsonc.
*/
{
    "jacketContainer": {
        // SPT 4.1.6 calibrated
        // Jacket vanilla pool weight: 125910 (167 items) -> Balanced target: ~25.0 keys / 100 containers
        "key": {
            "notExist": 136,
            "common": 136,
            "rare": 68,
            "superRare": 34
        },
        "keycard": {
            "notExist": 41,
            "common": 41,
            "rare": 20,
            "superRare": 13
        }
    },
    "duffleBagContainer": {
        // SPT 4.1.6 calibrated
        // Duffle Bag vanilla pool weight: 458069 (302 items) -> Balanced target: ~11.2 keys / 100 containers
        "key": {
            "notExist": 220,
            "common": 220,
            "rare": 110,
            "superRare": 55
        },
        "keycard": {
            "notExist": 66,
            "common": 66,
            "rare": 33,
            "superRare": 21
        }
    },
    "deadScavContainer": {
        // There are no dead Scavs in the Laboratory
        "key": {
            "notExist": 0,
            "common": 0,
            "rare": 0,
            "superRare": 0
        },
        "keycard": {
            "notExist": 0,
            "common": 0,
            "rare": 0,
            "superRare": 0
        }
    }
}
