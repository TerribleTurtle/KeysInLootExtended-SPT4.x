{
    // Internal config schema version. Older v2 configs missing this field are automatically
    // backed up to config.backup.jsonc and replaced with a fresh v3 config on server startup.
    "configVersion": 3,

    // =========================================================================
    // 1. GENERAL SETTINGS (Apply to all presets)
    // =========================================================================
    // Master on/off switch. Set false to leave Tarkov's vanilla container pools, prices, and grids untouched.
    "enabled": true,

    // Pick a preset below (not case-sensitive).
    // Playtime estimates assume ~3.5 raids in a 2-hour session (~5 Jackets, 4 Duffles, 1 Dead Scav per raid):
    //   "Hardcore" - ~2 keys per 2-hr night (~7.2 hrs per SuperRare)   | Vanilla container counts | 1.00x sell value
    //   "Balanced" - ~6.6 keys per 2-hr night (~1 SuperRare/night)     | Gentle Jacket curve      | 0.40x sell value (Default)
    //   "Casual"   - ~16 keys per 2-hr night (~3 SuperRares/night)     | Boosted Jacket & Duffle  | 0.25x sell value
    //   "Custom"   - Uses the manual weight and item-count tables in Section 2 ("custom") below
    "preset": "Balanced",

    // Mid/late-wipe filter: cuts Common (and uncategorized NotExist) weights by 85% on any preset so ~90% of drops are Rare or SuperRare.
    "reduceCommonKeys": false,

    // Master drop-rate dial applied on top of your chosen preset (1.0 = default, 1.5 = +50% weight, 0.5 = half weight).
    "spawnWeightMultiplier": 1.0,

    // Optional sell-price overrides. Leave null to use your preset's default sell value,
    // or set a number (e.g. 1.0 for full vanilla prices, 0.0 for worthless 0-rouble keys) on any preset.
    "fleaPriceMultiplier": null,
    "traderPriceMultiplier": null,

    // Simulated PMCs loot map containers and sell items to Fence. Set true to block injected keys from Fence.
    "banKeysFromFence": false,

    // Scales the per-map baseline files in locations/*.jsonc by your preset so small maps
    // (Labyrinth, Ground Zero) and large maps (Customs, Streets) give consistent drop rates.
    "enableLocationsConfig": true,

    // Set true to log evaluated per-map container key pool % when raids load.
    "debugLogs": false,

    // =========================================================================
    // 2. CUSTOM PRESET SETTINGS (Only used when preset is "Custom")
    // =========================================================================
    "custom": {
        // Spawn weights act like tickets added to a container's loot pool (Customs Jacket pool is ~200,000).
        // Set any tier to 0 to block that rarity from spawning. Whole integers only.
        "keyWeight": {
            "notExist": 200,
            "common": 200,
            "rare": 100,
            "superRare": 40
        },
        "keycardWeight": {
            "notExist": 60,
            "common": 60,
            "rare": 30,
            "superRare": 20
        },

        // Key sell-price multipliers used by "Custom" (1.0 = vanilla value; positive prices clamp >= 1 RUB).
        "fleaPriceMultiplier": 0.4,
        "traderPriceMultiplier": 0.4,

        // Container item-count overrides used by "Custom". Set false to keep vanilla item counts and grid sizes.
        // Set an individual container's array to null to leave that specific container on vanilla item counts.
        // Whole integers only (decimals in count/relativeProbability will fail config.jsonc loading at startup).
        "overrideLootDistribution": true,

        "jacketsItemCounts": [
            { "count": 3, "relativeProbability": 500 },
            { "count": 2, "relativeProbability": 2500 },
            { "count": 1, "relativeProbability": 6700 },
            { "count": 0, "relativeProbability": 300 }
        ],
        "duffleBagsItemCounts": null,
        "deadScavsItemCounts": null,

        // Minimum container grid dimensions (1 to 14) when overrideLootDistribution is true.
        // Expands smaller containers (2x2 Jackets -> 3x3) without shrinking larger ones (4x3 Duffles, 4x4 Dead Scavs).
        "minCellsH": 3,
        "minCellsV": 3
    }
}
