<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>KeysInLootExtended</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Library</OutputType>
    <Version>2.2.0</Version>
    <Authors>TerribleTurtle</Authors>
    <OutputPath>..\dist\SPT\user\mods\KeysInLootExtended\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SPTushonka.Common" Version="4.1.6" />
    <PackageReference Include="SPTushonka.DI" Version="4.1.6" />
    <PackageReference Include="SPTushonka.Server.Core" Version="4.1.6" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\config.jsonc">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\locations\**\*.jsonc">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>locations\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </None>
  </ItemGroup>

</Project>
